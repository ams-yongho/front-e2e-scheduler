SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

DASHBOARD_URL=http://<팀원이 접근 가능한 Mac IP>:8080

# E2E 로그인 자격증명 (스테이징 대상 e2e 프로젝트에서 사용)
# run-project.sh가 .env를 export하므로, 로그인이 필요한 프로젝트의 spec이 참조한다.
# scm-front 계열 (scm staging 공용 system 계정)
E2E_USERNAME=<스테이징 로그인 ID>
E2E_PASSWORD=<비밀번호>
# typist (CA 계열)
TYPIST_E2E_USERNAME=<typist 스테이징 로그인 ID>
TYPIST_E2E_PASSWORD=<비밀번호>

# 레포 동기화용 GitHub 토큰 (scripts/sync-repo.sh 가 git fetch 에 사용)
# cron 은 macOS 로그인 세션 밖에서 실행되어 키체인(osxkeychain / gh auth)을 읽지 못하므로 필요하다.
# 대상 레포 read 권한만 있는 fine-grained PAT(Contents: Read-only) 권장
GITHUB_TOKEN=<github 토큰>
